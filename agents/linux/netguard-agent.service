[Unit]
Description=SHALX NETGUARD Host Telemetry & Health Monitoring Agent
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/netguard
Environment=NETGUARD_SERVER_URL=http://192.168.30.10:8000
Environment=NETGUARD_AGENT_TOKEN=netguard-agent-secret-auth-token-2026
ExecStart=/usr/bin/python3 /opt/netguard/netguard_agent.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
