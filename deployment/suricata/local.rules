# SHALX NETGUARD SOC - Sample Suricata Custom Detection Rules
# Location: /etc/suricata/rules/local.rules

# 1. Port Scanning Detection
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"SHALX NETGUARD SCAN Potential Nmap TCP SYN Scan Detected"; flags:S; threshold:type both, track by_src, count 10, seconds 5; classtype:attempted-recon; sid:9000001; rev:1;)

# 2. SSH Brute Force Detection
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"SHALX NETGUARD AUTH Excessive Failed SSH Login Attempts (Brute Force)"; flow:to_server,established; content:"SSH-"; threshold:type both, track by_src, count 5, seconds 30; classtype:attempted-admin; sid:9000002; rev:1;)

# 3. Web Application SQL Injection Detection
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"SHALX NETGUARD WEB-ATTACK SQL Injection UNION SELECT Pattern in HTTP URI"; flow:to_server,established; content:"UNION"; nocase; http_uri; content:"SELECT"; nocase; http_uri; classtype:web-application-attack; sid:9000003; rev:1;)

# 4. High Entropy / DGA DNS Query Detection
alert udp $HOME_NET any -> any 53 (msg:"SHALX NETGUARD MALWARE Suspicious High-Entropy DGA Domain Resolution"; content:"|01 00 00 01|"; depth:4; offset:2; classtype:trojan-activity; sid:9000004; rev:1;)

# 5. Volumetric TCP SYN Flood DoS
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"SHALX NETGUARD DOS Rapid Inbound TCP SYN Flood"; flags:S; threshold:type threshold, track by_dst, count 100, seconds 2; classtype:denial-of-service; sid:9000005; rev:1;)
