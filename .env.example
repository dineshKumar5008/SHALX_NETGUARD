# ==============================================================================
# SHALX NETGUARD — Production Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Security Configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=prod
SECRET_KEY=change-me-to-a-cryptographically-secure-random-64-character-string
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. Domains, URLs & Production CORS
# ------------------------------------------------------------------------------
# Public URL of the deployed frontend (used for CORS and origin validation)
FRONTEND_URL=https://netguard.yourcompany.com

# Additional allowed origins (comma-separated if hosting across multiple domains)
CORS_ORIGINS=https://netguard.yourcompany.com,https://soc.yourcompany.com

# ------------------------------------------------------------------------------
# 3. Database Configuration
# ------------------------------------------------------------------------------
# SQLite (Persistent Volume path for single-instance / container deployments):
DATABASE_URL=sqlite+aiosqlite:///./netguard.db

# Managed PostgreSQL (Cloud / Render / Supabase / Neon / AWS RDS):
# DATABASE_URL=postgresql+asyncpg://netguard_user:secure_password@host:5432/netguard_db

# ------------------------------------------------------------------------------
# 4. Administrator Registered Account & Email Delivery (HTTPS API or SMTP)
# ------------------------------------------------------------------------------
# Administrator registered email address (MFA OTPs will be delivered here)
ADMIN_EMAIL=admin@yourcompany.com

# Active Transactional Email Provider: 'resend', 'brevo', 'sendgrid', or 'smtp'
EMAIL_PROVIDER=resend

# HTTP API Provider 1: Resend (Recommended for Render Free tier - Port 443 HTTPS)
# Free 3,000 emails/mo. Sign up at https://resend.com and create an API Key.
RESEND_API_KEY=re_123456789abcdef
EMAIL_FROM="SHALX NETGUARD SOC <onboarding@resend.dev>"
EMAIL_FROM_NAME="SHALX NETGUARD SOC"

# HTTP API Provider 2: Brevo / Sendinblue (Alternative HTTPS API)
# Free 300 emails/day. Sign up at https://brevo.com
# BREVO_API_KEY=xkeysib-123456789abcdef

# HTTP API Provider 3: SendGrid (Alternative HTTPS API)
# SENDGRID_API_KEY=SG.123456789abcdef

# Direct SMTP TCP Connection (Fallback for localhost or paid hosting where port 587 is unblocked)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=notifications@yourcompany.com
# SMTP_PASSWORD=your-16-character-app-password
# SMTP_FROM_EMAIL=notifications@yourcompany.com
# SMTP_FROM_NAME="SHALX NETGUARD Security"
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

# ------------------------------------------------------------------------------
# 5. Multi-Factor Authentication (MFA) & Password Reset Policies
# ------------------------------------------------------------------------------
MFA_OTP_EXPIRE_MINUTES=5
MFA_MAX_VERIFY_ATTEMPTS=5
MFA_MAX_RESENDS_PER_WINDOW=3
MFA_RESEND_WINDOW_MINUTES=10

# ------------------------------------------------------------------------------
# 6. Remote Network Sensor Integration
# ------------------------------------------------------------------------------
# Secret token used by authorized physical network sensors to ingest LAN discovery batches
AGENT_AUTH_TOKEN=netguard-agent-secret-auth-token-2026

# ------------------------------------------------------------------------------
# 7. Persistent Report Storage
# ------------------------------------------------------------------------------
REPORTS_STORAGE_PATH=./reports_storage
