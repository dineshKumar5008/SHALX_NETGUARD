# ==============================================================================
# SHALX NETGUARD — Real Email MFA & SMTP Configuration
# ==============================================================================

# 1. Administrator Account Real Registered Email
# Future MFA OTP verification codes for the 'admin' account will be delivered strictly to this address.
ADMIN_EMAIL=your-real-email@gmail.com

# 2. Gmail / SMTP Real Email Delivery Configuration
# For Gmail:
#   - SMTP_HOST: smtp.gmail.com
#   - SMTP_PORT: 587
#   - SMTP_USERNAME: your Gmail address (e.g. user@gmail.com)
#   - SMTP_PASSWORD: 16-character Google App Password (generated from Google Account -> Security -> 2-Step Verification -> App Passwords)
#   - SMTP_FROM_EMAIL: your Gmail address or verified sender
#   - SMTP_FROM_NAME: SHALX NETGUARD
#   - SMTP_USE_TLS: true
#   - SMTP_USE_SSL: false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-real-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-real-email@gmail.com
SMTP_FROM_NAME="SHALX NETGUARD"
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# 3. Security & Multi-Factor Authentication Policies
MFA_OTP_EXPIRE_MINUTES=5
MFA_MAX_VERIFY_ATTEMPTS=5
MFA_MAX_RESENDS_PER_WINDOW=3
MFA_RESEND_WINDOW_MINUTES=10

# 4. Database
DATABASE_URL=sqlite+aiosqlite:///./netguard.db
